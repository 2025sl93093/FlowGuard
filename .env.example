# GitHub webhook secret — set this in your GitHub repo webhook settings
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here

# Gmail credentials — use an App Password (not your real password)
# Enable 2FA → Google Account → Security → App Passwords → generate one
GMAIL_USERNAME=your.email@gmail.com
GMAIL_APP_PASSWORD=xxxx_xxxx_xxxx_xxxx

# Who receives alert emails
NOTIFICATION_RECIPIENT_EMAIL=your.email@gmail.com

# Your Docker Hub username (for image tagging)
DOCKER_HUB_USERNAME=yourdockerhubusername

# Postgres credentials (change in production)
POSTGRES_USER=flowguard
POSTGRES_PASSWORD=flowguard123

# RabbitMQ credentials
RABBITMQ_DEFAULT_USER=flowguard
RABBITMQ_DEFAULT_PASS=flowguard123
